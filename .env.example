# Copy to .env and fill in. Never commit .env.

# Credentials for the target app's login form (only if `auth` is set in the config).
# Names must match the `valueEnv` entries in your config.
A11Y_TEST_EMAIL=
A11Y_TEST_PASSWORD=

# API key for the LLM service (only for mode: rules+llm).
# The variable name is set by `llm.apiKeyEnv` in your config; any provider works.
LLM_API_KEY=
